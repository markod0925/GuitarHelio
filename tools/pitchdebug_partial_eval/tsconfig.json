{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "../../analysis/pitchdebug_partial_eval/.compiled",
    "rootDir": "../..",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "*.ts",
    "../../src/vite-env.d.ts",
    "../../src/audio/dsp-core/gh_dsp_core.js"
  ]
}
